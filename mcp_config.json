{
  "mcpServers": {
    "lucerna-mcp": {
      "command": "uv",
      "args": [
        "run",
        "lucerna-mcp"
      ],
      "env": {
        "MCP_TOOL_MODE": "intent",
        "INGESTTOOL": "True",
        "OPENSEARCHTOOL": "True",
        "OPENSEARCH_KEYCLOAK_CLIENT_ID": "opensearch",
        "OPENSEARCH_URL": "http://localhost:9200"
      }
    }
  }
}
